{
  "name": "hog",
  "displayName": "Hog",
  "description": "Language support, project explorer and workflow commands for Hog (https://cern.ch/hog)",
  "publisher": "DavideCieri",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hog-CERN/HogVSCode"
  },
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:hog",
    "onLanguage:hog-conf",
    "workspaceContains:**/Top/**/hog.conf"
  ],
  "main": "./out/extension.js",
  "author": {
    "email": "davide.cieri89@gmail.com",
    "name": "Davide Cieri"
  },
  "keywords": [
    "hog",
    "hdl",
    "fpga",
    "vivado",
    "quartus",
    "vhdl",
    "syntax"
  ],
  "homepage": "https://cern.ch/hog",
  "icon": "hog.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hog",
          "title": "Hog",
          "icon": "media/hog-logo.png"
        }
      ]
    },
    "views": {
      "hog": [
        {
          "id": "hog.projects",
          "name": "Projects"
        },
        {
          "id": "hog.hierarchy",
          "name": "Hierarchy"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hog.projects",
        "contents": "No Hog projects found.\nHog projects live in `Top/<name>/hog.conf` of the workspace root.\n[Refresh](command:hog.refresh)"
      },
      {
        "view": "hog.hierarchy",
        "contents": "No hierarchy yet.\nRun Hog TREE on a project to see its design hierarchy.\n[Show Hierarchy](command:hog.hierarchy)"
      }
    ],
    "commands": [
      {
        "command": "hog.createproject",
        "title": "Create Project",
        "category": "Hog",
        "icon": "$(add)"
      },
      {
        "command": "hog.openproject",
        "title": "Open Project in IDE",
        "category": "Hog",
        "icon": "$(link-external)"
      },
      {
        "command": "hog.workflow",
        "title": "Run Workflow",
        "category": "Hog",
        "icon": "$(play)"
      },
      {
        "command": "hog.synthesis",
        "title": "Run Synthesis",
        "category": "Hog",
        "icon": "$(gear)"
      },
      {
        "command": "hog.implementation",
        "title": "Run Implementation",
        "category": "Hog",
        "icon": "$(run-all)"
      },
      {
        "command": "hog.simulation",
        "title": "Run Simulation",
        "category": "Hog",
        "icon": "$(beaker)"
      },
      {
        "command": "hog.checksyntax",
        "title": "Check Syntax",
        "category": "Hog",
        "icon": "$(check)"
      },
      {
        "command": "hog.checklist",
        "title": "Check List Files",
        "category": "Hog",
        "icon": "$(checklist)"
      },
      {
        "command": "hog.stop",
        "title": "Stop Running Command",
        "category": "Hog",
        "icon": "$(debug-stop)"
      },
      {
        "command": "hog.refresh",
        "title": "Refresh Projects",
        "category": "Hog",
        "icon": "$(refresh)"
      },
      {
        "command": "hog.showMenu",
        "title": "Show Hog Menu",
        "category": "Hog",
        "icon": "$(circuit-board)"
      },
      {
        "command": "hog.hierarchy",
        "title": "Show Design Hierarchy",
        "category": "Hog",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "hog.clearhierarchy",
        "title": "Clear Design Hierarchy",
        "category": "Hog",
        "icon": "$(clear-all)"
      },
      {
        "command": "hog.clearProblems",
        "title": "Clear Build Problems",
        "category": "Hog",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hog.refresh",
          "when": "view == hog.projects",
          "group": "navigation"
        },
        {
          "command": "hog.clearhierarchy",
          "when": "view == hog.hierarchy",
          "group": "navigation"
        },
        {
          "command": "hog.hierarchy",
          "when": "view == hog.hierarchy",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "hog.createproject",
          "when": "view == hog.projects && viewItem == hogProject.new",
          "group": "inline@1"
        },
        {
          "command": "hog.openproject",
          "when": "view == hog.projects && viewItem == hogProject.created",
          "group": "inline@1"
        },
        {
          "command": "hog.hierarchy",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "inline@3"
        },
        {
          "command": "hog.workflow",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "inline@2"
        },
        {
          "command": "hog.createproject",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "1_run@1"
        },
        {
          "command": "hog.workflow",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "1_run@2"
        },
        {
          "command": "hog.synthesis",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "1_run@3"
        },
        {
          "command": "hog.implementation",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "1_run@4"
        },
        {
          "command": "hog.simulation",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "1_run@5"
        },
        {
          "command": "hog.checksyntax",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "2_check@1"
        },
        {
          "command": "hog.checklist",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "2_check@2"
        },
        {
          "command": "hog.openproject",
          "when": "view == hog.projects && viewItem == hogProject.created",
          "group": "3_open@1"
        },
        {
          "command": "hog.hierarchy",
          "when": "view == hog.projects && viewItem =~ /^hogProject/",
          "group": "2_check@3"
        }
      ]
    },
    "configuration": {
      "title": "Hog",
      "properties": {
        "hog.doScript": {
          "type": "string",
          "default": "Hog/Do",
          "description": "Path of the Hog launcher script, relative to the workspace root (or absolute)."
        },
        "hog.vivadoPath": {
          "type": "string",
          "default": "vivado",
          "description": "Vivado executable used by \"Open Project in IDE\"."
        },
        "hog.quartusPath": {
          "type": "string",
          "default": "quartus",
          "description": "Quartus executable used by \"Open Project in IDE\"."
        },
        "hog.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Warn about missing files and unknown modifiers in Hog list files."
        },
        "hog.problems.includeWarnings": {
          "type": "boolean",
          "default": false,
          "description": "Also show WARNING messages from Hog and the vendor tools in the Problems panel (errors and critical warnings are always shown)."
        }
      }
    },
    "languages": [
      {
        "id": "hog",
        "aliases": [
          "Hog",
          "hog"
        ],
        "extensions": [
          ".src",
          ".sim",
          ".con",
          ".lst",
          ".ext",
          ".ipb",
          ".sub"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hog-conf",
        "aliases": [
          "Hog Configuration",
          "hog-conf"
        ],
        "filenames": [
          "hog.conf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hog",
        "scopeName": "source.hog-list",
        "path": "./syntaxes/hog-list.tmLanguage.json"
      },
      {
        "language": "hog-conf",
        "scopeName": "source.hog-conf",
        "path": "./syntaxes/hog-conf.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "~1.85.0",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.34.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  }
}
