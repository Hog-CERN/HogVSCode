// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false // set this to true to hide the "out" folder with the compiled JS files
    },
    "search.exclude": {
        "out": true // set this to false to include "out" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off",
    "workbench.colorCustomizations": {
        "activityBar.background": "#223204",
        "titleBar.activeBackground": "#2F4706",
        "titleBar.activeForeground": "#F5FDE5",
        "titleBar.inactiveBackground": "#223204",
        "titleBar.inactiveForeground": "#F5FDE5",
        "statusBar.background": "#223204",
        "statusBar.foreground": "#F5FDE5",
        "statusBar.debuggingBackground": "#223204",
        "statusBar.debuggingForeground": "#F5FDE5",
        "statusBar.noFolderBackground": "#223204",
        "statusBar.noFolderForeground": "#F5FDE5"
    }
}