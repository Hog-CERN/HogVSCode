// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "out": false // set this to true to hide the "out" folder with the compiled JS files
    },
    "search.exclude": {
        "out": true // set this to false to include "out" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "typescript.tsc.autoDetect": "off",
    "workbench.colorCustomizations": {
        "statusBar.noFolderBackground": "#610606",
        "statusBar.noFolderForeground": "#FFFBFB",
        "activityBar.background": "#610606",
        "titleBar.activeBackground": "#880909",
        "titleBar.activeForeground": "#FFFBFB",
        "titleBar.inactiveBackground": "#610606",
        "titleBar.inactiveForeground": "#FFFBFB",
        "statusBar.background": "#610606",
        "statusBar.foreground": "#FFFBFB",
        "statusBar.debuggingBackground": "#610606",
        "statusBar.debuggingForeground": "#FFFBFB"
    }
}